# Copy to .env on the server; never commit real values.
BOT_TOKEN=
OWNER_ID=
MONGODB_URI=
MONGODB_DB_NAME=
SERVICE_ROLE=all
# Private source channel ID (bot must be an administrator)
SOURCE_CHANNEL_ID=
# Optional channel for mirroring generated deeplinks and formatted captions
DEEPLINK_CHANNEL=
# Comma-separated required channels, e.g. @channel_one,@channel_two
FORCE_JOIN_CHANNELS=
LOG_LEVEL=INFO
